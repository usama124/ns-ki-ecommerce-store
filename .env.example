PAYLOAD_SECRET=mygeneratedsecret

# Database Configuration (Choose one adapter via DB_ADAPTER or connection string format)
# Option A: MongoDB (Local or Atlas)
DB_ADAPTER=mongodb
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/nski?retryWrites=true&w=majority

# Per warm application instance: defaults are 10 MongoDB / 5 PostgreSQL connections.
# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=10000

# Option B: PostgreSQL (Supabase / Neon / Local)
# DB_ADAPTER=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/nski

# Option C: Turso (SQLite)
# DB_ADAPTER=turso
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-token

COMPANY_NAME="Payload Inc."
TWITTER_CREATOR="@payloadcms"
TWITTER_SITE="https://nextjs.org/commerce"
SITE_NAME="Payload Commerce"

PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used to preview drafts
PREVIEW_SECRET=demo-draft-secret

# Cloudflare R2 Object Storage & CDN Configuration
# Set these variables to upload media assets to Cloudflare R2 bucket with MIME subfolder routing
R2_BUCKET=lujain-media
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://media.lujain.com

# Separate private receipt bucket. Keep public access disabled.
# Endpoint format: https://<account_id>.r2.cloudflarestorage.com
# Use credentials restricted to this bucket. Never use NEXT_PUBLIC_ here.
R2_RECEIPTS_BUCKET=
R2_RECEIPTS_ENDPOINT=
R2_RECEIPTS_ACCESS_KEY_ID=
R2_RECEIPTS_SECRET_ACCESS_KEY=

# Transactional Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=orders@nski.pk # or onboarding@resend.dev during testing
ADMIN_EMAIL=admin@nski.pk

# Server-only random secret (32+ chars) for your email dispatcher scheduler.
# Schedule GET /api/admin/commerce/dispatch with Authorization: Bearer <secret>.
COMMERCE_WORKER_SECRET=

